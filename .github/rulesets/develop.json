{
  "name": "develop",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Build web", "integration_id": 15368 },
          { "context": "E2E", "integration_id": 15368 },
          { "context": "Test", "integration_id": 15368 },
          { "context": "Build distribution binaries", "integration_id": 15368 },
          { "context": "Build Docker images (linux/amd64)", "integration_id": 15368 },
          { "context": "Build Docker images (linux/arm64)", "integration_id": 15368 },
          { "context": "Build Docker images (linux/arm/v7)", "integration_id": 15368 },
          { "context": "Build Docker images (linux/arm/v6)", "integration_id": 15368 },
          { "context": "Publish Docker multi-arch manifest", "integration_id": 15368 },
          { "context": "main", "integration_id": 15368 },
          { "context": "build-apk", "integration_id": 15368 },
          { "context": "build-suwayomi", "integration_id": 15368 },
          { "context": "e2e", "integration_id": 15368 },
          { "context": "e2e-v1", "integration_id": 15368 }
        ]
      }
    }
  ]
}
